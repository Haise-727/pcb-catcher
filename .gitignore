# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
web/dist/

# Runtime data — inspection records and captured images are local-only
# and can contain customer design IP (NFR-011). Never commit them.
data/*.db
data/*.db-wal
data/*.db-shm
data/images/
data/golden/

# OS
.DS_Store

# Generated marker sheet — reproducible via tools/make_markers.py
tools/markers/

# Demo board images — regenerate with tools/make_demo_boards.py.
# Not committed because the render noise defeats PNG compression (~1.1MB each)
# and the generator is deterministic.
demo/*.png
data/*.jsonl
data/*.jsonl.*
demo_dense/
